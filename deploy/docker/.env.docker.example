# 用户端与管理端共用同一个 MySQL 库；现场 MySQL 已独立安装，因此容器不包含 MySQL。
FRUIT_ANALYSIS_DATABASE_URL=mysql+pymysql://fruits_user:CHANGE_ME@127.0.0.1:3306/fruits_ana?charset=utf8mb4

# AI 大模型（不配置时相关 AI 功能不可用）
FRUIT_ANALYSIS_AI_BASE_URL=
FRUIT_ANALYSIS_AI_API_KEY=
FRUIT_ANALYSIS_AI_MODEL=

# 现场如果使用 HTTPS 反向代理，再把下面两个值改为 true
FRUIT_ANALYSIS_COOKIE_SECURE=false
FRUIT_ADMIN_COOKIE_SECURE=false

# 管理端使用独立 Cookie，避免与用户端 fruit_session 冲突
FRUIT_ADMIN_SESSION_COOKIE=fruit_admin_session

# 按现场访问地址修改，多个地址用英文逗号分隔
FRUIT_ADMIN_CORS_ORIGINS=http://127.0.0.1:54000,http://localhost:54000

TZ=Asia/Shanghai
