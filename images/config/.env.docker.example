# 用户端生产环境配置；现场 MySQL 已独立安装，因此容器不包含 MySQL。
FRUIT_ANALYSIS_DATABASE_URL=mysql+pymysql://fruits_user:CHANGE_ME@127.0.0.1:3306/fruits_ana?charset=utf8mb4

# AI 大模型（不配置时相关 AI 功能不可用）
FRUIT_ANALYSIS_AI_BASE_URL=
FRUIT_ANALYSIS_AI_API_KEY=
FRUIT_ANALYSIS_AI_MODEL=

# 现场如果使用 HTTPS 反向代理，再改为 true
FRUIT_ANALYSIS_COOKIE_SECURE=false

# SMTP 邮件发送（注册验证码 / 重置密码）
FRUIT_ANALYSIS_SMTP_HOST=smtp.example.com
FRUIT_ANALYSIS_SMTP_PORT=465
FRUIT_ANALYSIS_SMTP_USER=your-email@example.com
FRUIT_ANALYSIS_SMTP_PASSWORD=CHANGE_ME
FRUIT_ANALYSIS_SMTP_FROM=your-email@example.com

TZ=Asia/Shanghai
