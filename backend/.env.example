# 后端优先读取 FRUIT_ANALYSIS_DATABASE_URL；未设置时使用以下 MySQL 参数。
# FRUIT_ANALYSIS_DATABASE_URL=mysql+pymysql://user:password@host:3306/fruits_ana?charset=utf8mb4
FRUIT_ANALYSIS_DB_HOST=120.48.117.234
FRUIT_ANALYSIS_DB_PORT=13306
FRUIT_ANALYSIS_DB_USER=root
FRUIT_ANALYSIS_DB_PASSWORD=change-me
FRUIT_ANALYSIS_DB_NAME=fruits_ana

# 应用运行日志（控制台 + 轮转文件）
FRUIT_ANALYSIS_LOG_LEVEL=INFO
FRUIT_ANALYSIS_LOG_DIR=backend/data/logs
FRUIT_ANALYSIS_LOG_FILE=fruits_ana.log
FRUIT_ANALYSIS_LOG_MAX_BYTES=5242880
FRUIT_ANALYSIS_LOG_BACKUP_COUNT=5

# AI 大模型（可选；不配置 API Key 时 AI 分析功能不可用）
FRUIT_ANALYSIS_AI_BASE_URL=https://api.deepseek.com
FRUIT_ANALYSIS_AI_API_KEY=change-me
FRUIT_ANALYSIS_AI_MODEL=deepseek-chat

# SMTP 邮件发送（注册验证码）
FRUIT_ANALYSIS_SMTP_HOST=smtp.example.com
FRUIT_ANALYSIS_SMTP_PORT=465
FRUIT_ANALYSIS_SMTP_USER=your-email@example.com
FRUIT_ANALYSIS_SMTP_PASSWORD=change-me
FRUIT_ANALYSIS_SMTP_FROM=your-email@example.com
